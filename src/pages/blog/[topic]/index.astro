---
import Base from '../../../layouts/Base.astro';
import { byReadingOrder, getPosts, seriesOf, topicOf } from '../../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();

	const topics = [
		...new Set(posts.map(topicOf).filter((t): t is string => Boolean(t))),
	];

	return topics.map((topic) => ({ params: { topic } }));
}

const { topic } = Astro.params;

const inTopic = (await getPosts()).filter((post) => topicOf(post) === topic);

// Series run in curriculum order — earliest post first — so "basics" always
// sits above "composite-types" rather than wherever the filesystem put it.
const earliestBySeries = new Map<string, Date>();

for (const post of inTopic) {
	const name = seriesOf(post);
	if (!name) continue;

	const seen = earliestBySeries.get(name);
	if (!seen || post.data.pubDate < seen) {
		earliestBySeries.set(name, post.data.pubDate);
	}
}

const series = [...earliestBySeries.entries()]
	.sort((a, b) => a[1].valueOf() - b[1].valueOf())
	.map(([name]) => name);

// Posts that belong to the topic but to no series. These used to render as
// one-post "series" cards reading "Explore posts inside this series."
const standalone = inTopic.filter((post) => !seriesOf(post)).sort(byReadingOrder);
---

<Base title={topic} description={`Posts and series in ${topic}`}>
	<main>
		<div class="hero">
			<h1>{topic}</h1>
			<p>Series and structured learning paths.</p>
		</div>

		{
			series.length > 0 && (
				<div class="grid">
					{series.map((item) => (
						<a class="card" href={`/blog/${topic}/${item}`}>
							<h2>{item}</h2>
							<p>Explore posts inside this series.</p>
						</a>
					))}
				</div>
			)
		}

		{
			standalone.length > 0 && (
				<section class="standalone">
					{series.length > 0 && <h2 class="section-title">Other posts</h2>}
					<ul class="post-list">
						{standalone.map((post) => (
							<li>
								<a class="post-card" href={`/blog/${post.id}/`}>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</main>
</Base>

<style>
	main {
		--main-max: 1100px;
		padding: 3rem 1.5rem;
	}

	.hero {
		text-align: center;
		margin-bottom: 4rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 2rem;
	}

	.card {
		padding: 2rem;
		border-radius: 28px;
		background: var(--surface);
		border: 1px solid var(--line);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		color: var(--ink);
		transition: 0.25s;
	}

	.card:hover {
		transform: translateY(-6px);
	}

	.standalone {
		margin-top: 3.5rem;
	}

	.section-title {
		font-size: var(--text-h3);
		margin-bottom: 1.5rem;
	}

	.post-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.post-card {
		display: block;
		padding: 1.75rem 2rem;
		border-radius: 24px;
		text-decoration: none;
		background: var(--surface);
		border: 1px solid var(--line);
		box-shadow: var(--shadow-sm);
		color: var(--ink);
		transition: 0.2s;
	}

	.post-card:hover {
		transform: translateY(-4px);
	}

	.post-card h3 {
		margin-top: 0;
		font-size: var(--text-h4);
	}

	.post-card p {
		margin-bottom: 0;
		color: var(--muted);
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		.post-card {
			transition: none;
		}

		.card:hover,
		.post-card:hover {
			transform: none;
		}
	}
</style>

---
import Base from '../../../../layouts/Base.astro';
import {
	byReadingOrder,
	getPosts,
	seriesOf,
	topicOf,
} from '../../../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();

	// One entry per series, not per post. Returning a duplicate for every post
	// made Astro emit a route-conflict warning for each redundant one.
	const seen = new Set<string>();
	const paths = [];

	for (const post of posts) {
		const topic = topicOf(post);
		const series = seriesOf(post);

		if (!topic || !series) continue;

		const key = `${topic}/${series}`;
		if (seen.has(key)) continue;

		seen.add(key);
		paths.push({ params: { topic, series } });
	}

	return paths;
}

const { topic, series } = Astro.params;

// A series is a reading order, so oldest first — not newest first like the feed.
const posts = (await getPosts())
	.filter((post) => topicOf(post) === topic && seriesOf(post) === series)
	.sort(byReadingOrder);
---

<Base title={series} description={`Posts in the ${series} series`}>
	<main>
		<h1>{series}</h1>

		<ul class="post-list">
			{
				posts.map((post) => (
					<li>
						<a class="post-card" href={`/blog/${post.id}/`}>
							<h3>{post.data.title}</h3>
							<p>{post.data.description}</p>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</Base>

<style>
	main {
		--main-max: 900px;
		padding: 3rem 1.5rem;
	}

	.post-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.post-card {
		display: block;
		padding: 2rem;
		border-radius: 24px;
		text-decoration: none;
		background: var(--surface);
		border: 1px solid var(--line);
		box-shadow: var(--shadow-sm);
		color: var(--ink);
		transition: 0.2s;
	}

	.post-card:hover {
		transform: translateY(-4px);
	}

	.post-card h3 {
		margin-top: 0;
		font-size: var(--text-h4);
	}

	.post-card p {
		margin-bottom: 0;
		color: var(--muted);
	}

	@media (prefers-reduced-motion: reduce) {
		.post-card {
			transition: none;
		}

		.post-card:hover {
			transform: none;
		}
	}
</style>

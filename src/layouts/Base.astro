---
/**
 * The only place the document shell is written.
 *
 * Every page renders through this, so `lang`, the head, the header and the
 * footer cannot drift between routes or be forgotten on a new one. Pages
 * supply their own <main> and style it directly — set `--main-max` on it to
 * widen past the default reading column.
 */
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	/** Social-card image. Falls back to the site default when omitted. */
	image?: ImageMetadata;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>

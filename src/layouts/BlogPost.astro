---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CopyCode from '../components/CopyCode.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostNav from '../components/PostNav.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { Post } from '../lib/posts';
import Base from './Base.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
	topic?: string | undefined;
	series?: string | undefined;
	minutes?: number;
	prev?: Post | undefined;
	next?: Post | undefined;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	headings = [],
	topic,
	series,
	minutes,
	prev,
	next,
} = Astro.props;

const hasToc = headings.filter((h) => h.depth === 2 || h.depth === 3).length >= 3;
---

<Base title={title} description={description} image={heroImage}>
	<main class:list={{ 'has-toc': hasToc }}>
		<article>
			{
				heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)
			}

			<header class="post-head">
				<Breadcrumbs topic={topic} series={series} />
				<h1>{title}</h1>
				<p class="meta">
					<FormattedDate date={pubDate} />
					{minutes && <span>· {minutes} min read</span>}
					{
						updatedDate && (
							<span class="updated">
								· Updated <FormattedDate date={updatedDate} />
							</span>
						)
					}
				</p>
			</header>

			<div class="post-body">
				{
					hasToc && (
						<aside class="toc-rail">
							<TableOfContents headings={headings} />
						</aside>
					)
				}
				<div class="prose">
					<slot />
				</div>
			</div>

			<div class="post-foot">
				<PostNav prev={prev} next={next} />
			</div>
		</article>
	</main>
</Base>

<CopyCode />

<style>
	main {
		--main-max: 1100px;
	}

	.hero-image {
		width: 100%;
	}

	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: var(--radius);
		border: 1px solid var(--line);
	}

	.post-head {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 2.5em 0 1.5em;
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		border-bottom: 1px solid var(--line);
		margin-bottom: 2.5rem;
	}

	.post-head h1 {
		margin: 0;
	}

	.meta {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--muted);
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.4em;
	}

	.updated {
		font-style: italic;
	}

	.post-body {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: center;
	}

	.prose {
		width: 100%;
		max-width: var(--measure);
	}

	.post-foot {
		max-width: var(--measure);
		margin: 0 auto;
	}

	/*
	  The rail only appears when there is room for it beside a full-width
	  reading column. Below that it would either squeeze the prose or stack
	  above it as a wall of links, so it is dropped instead.
	*/
	.toc-rail {
		display: none;
	}

	@media (min-width: 1100px) {
		main.has-toc .post-body {
			grid-template-columns: 14rem minmax(0, var(--measure));
			justify-content: center;
			justify-items: start;
			gap: 3rem;
		}

		main.has-toc .toc-rail {
			display: block;
			position: sticky;
			top: 2rem;
			align-self: start;
			max-height: calc(100vh - 4rem);
			overflow-y: auto;
		}

		/* Keep the title and the footer aligned over the prose column, not the
		   whole grid, so the rail doesn't push them off-centre. */
		main.has-toc .post-head,
		main.has-toc .post-foot {
			margin-left: calc(14rem + 3rem);
			margin-right: 0;
		}
	}
</style>

---
import { labelOf, type Post } from '../lib/posts';

interface Props {
	prev?: Post | undefined;
	next?: Post | undefined;
	topic?: string | undefined;
	series?: string | undefined;
}

const { prev, next, topic, series } = Astro.props;

// Where "up" goes: the series if the post is in one, otherwise its topic.
const up = topic
	? series
		? { href: `/blog/${topic}/${series}/`, label: labelOf(series) }
		: { href: `/blog/${topic}/`, label: labelOf(topic) }
	: { href: '/blog/', label: 'Writing' };
---

<nav class="post-nav" aria-label="Post navigation">
	<a class="up" href={up.href}>
		<span class="dir"><svg class="arrow up-arrow" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 9.5 8 4.5l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Back to</span>
		<span class="title">{up.label}</span>
	</a>

	{
		(prev || next) && (
			<div class="siblings">
				{prev ? (
					<a class="prev" href={`/blog/${prev.id}/`} rel="prev">
						<span class="dir"><svg class="arrow" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M9.5 3 4.5 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Previous</span>
						<span class="title">{prev.data.title}</span>
					</a>
				) : (
					<span />
				)}

				{next && (
					<a class="next" href={`/blog/${next.id}/`} rel="next">
						<span class="dir">Next<svg class="arrow" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M6.5 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
						<span class="title">{next.data.title}</span>
					</a>
				)}
			</div>
		)
	}
</nav>

<style>
	.post-nav {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--line);
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.siblings {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.post-nav a {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		text-decoration: none;
		color: var(--ink);
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.siblings a {
		padding: 1rem 0;
		border-top: 1px solid var(--line);
	}

	.post-nav a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	/* The way out of the series, not just along it. */
	.up {
		align-self: start;
		padding: 0.7em 1.1em;
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}

	.siblings .next {
		text-align: right;
		grid-column: 2;
	}

	.siblings .next .dir {
		justify-content: flex-end;
	}

	/* SVG arrows rather than glyphs — see the note in Breadcrumbs.astro. */
	.arrow {
		display: block;
		flex: none;
	}

	.dir {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
		font-size: var(--text-label);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.title {
		font-weight: 700;
		line-height: 1.3;
	}

	@media (max-width: 640px) {
		.siblings {
			grid-template-columns: 1fr;
		}

		.siblings .next {
			grid-column: 1;
			text-align: left;
		}
	}
</style>

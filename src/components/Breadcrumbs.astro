---
import { labelOf } from '../lib/posts';

interface Props {
	topic?: string | undefined;
	series?: string | undefined;
	/** BlogPost centres its header, so its breadcrumb centres with it. */
	center?: boolean;
	/**
	 * True when the current page sits *below* the last crumb — a post inside a
	 * series, whose own title is the <h1> and so never appears in the trail.
	 *
	 * This changes two things, and getting it wrong is silent: which crumb is
	 * marked aria-current, and where "back" goes. On a series index the last
	 * crumb is you, so back is its parent. On a post the last crumb is already
	 * the parent, so back is the last crumb itself.
	 */
	leaf?: boolean;
}

const { topic, series, center = false, leaf = false } = Astro.props;

const crumbs = [{ label: 'Writing', href: '/blog/' }];

if (topic) crumbs.push({ label: labelOf(topic), href: `/blog/${topic}/` });
if (topic && series) {
	crumbs.push({ label: labelOf(series), href: `/blog/${topic}/${series}/` });
}

const currentIndex = leaf ? -1 : crumbs.length - 1;
const back = leaf
	? crumbs[crumbs.length - 1]
	: (crumbs[crumbs.length - 2] ?? crumbs[0]);
---

<nav class:list={['crumbs', { center }]} aria-label="Breadcrumb">
	<a class="back" href={back.href}>
		<span aria-hidden="true">←</span>
		{back.label}
	</a>

	<ol>
		{
			crumbs.map((crumb, i) => (
				<li>
					{i > 0 && (
						<span class="sep" aria-hidden="true">
							/
						</span>
					)}
					{i === currentIndex ? (
						<span aria-current="page">{crumb.label}</span>
					) : (
						<a href={crumb.href}>{crumb.label}</a>
					)}
				</li>
			))
		}
	</ol>
</nav>

<style>
	.crumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.6em 1.25em;
	}

	.crumbs.center {
		justify-content: center;
	}

	.crumbs ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}

	.crumbs li {
		display: flex;
		gap: 0.5em;
		align-items: baseline;
	}

	.crumbs a,
	.crumbs span,
	.back {
		font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
		font-size: var(--text-label);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.crumbs ol a,
	.sep {
		color: var(--muted);
		text-decoration: none;
	}

	.crumbs ol a:hover {
		color: var(--accent);
	}

	.crumbs [aria-current='page'] {
		color: var(--ink);
		font-weight: 700;
	}

	/*
	  An explicit way out, not just a trail showing where you are. The trail
	  tells you the structure; this is the button you actually press.
	*/
	.back {
		display: inline-flex;
		/* The arrow is a symbol, not a letter — sitting it on the text baseline
		   drops it below the cap height and it reads as falling off the row. */
		align-items: center;
		gap: 0.5em;
		font-weight: 700;
		text-decoration: none;
		color: var(--accent);
		padding: 0.45em 0.9em;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.back:hover {
		border-color: var(--accent);
		color: var(--accent-hover);
	}

	/* On a phone the trail is redundant next to the button. */
	@media (max-width: 560px) {
		.crumbs ol {
			display: none;
		}
	}
</style>
